# Variabili d'ambiente delle Netlify Functions.
# I valori si impostano SOLO su Netlify (Site configuration → Environment variables)
# o in un file .env locale che NON va mai committato.

# URL del progetto Supabase (https://<progetto>.supabase.co)
SUPABASE_URL=
# Chiave anon / publishable di Supabase — usata solo lato server (functions e build), mai nel browser.
# Su Netlify SUPABASE_URL e SUPABASE_ANON_KEY servono sia alle Functions sia alle Builds
# (build.py legge i contenuti pubblicati del CMS).
SUPABASE_ANON_KEY=
# Origin del sito (più valori separati da virgola), es. https://meekondisplay.ch
ALLOWED_ORIGIN=
# URL del build hook di Netlify (https://api.netlify.com/build_hooks/<id>), usato
# solo da /api/pubblica. È un segreto: chi lo conosce può far ricostruire il sito.
NETLIFY_BUILD_HOOK=
