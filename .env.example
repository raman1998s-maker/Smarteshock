# Variabili d'ambiente delle Netlify Functions.
# I valori si impostano SOLO su Netlify (Site configuration → Environment variables)
# o in un file .env locale che NON va mai committato.

# URL del progetto Supabase (https://<progetto>.supabase.co)
SUPABASE_URL=
# Chiave anon / publishable di Supabase — usata solo lato server, mai nel browser
SUPABASE_ANON_KEY=
# Origin del sito (più valori separati da virgola), es. https://meekondisplay.ch
ALLOWED_ORIGIN=
